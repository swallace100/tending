  m_Script: {fileID: 11500000, guid: 4202dce0c795c2146b9f06a15f87c9d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SelfCheckIn
  questions:
  - questionText: Are you cold?
    discomfortLabel: Cold
    suggestion: Grab a blanket or layer up if you can.
  - questionText: Are you hot?
    discomfortLabel: Hot
    suggestion: Turn on a fan or have a glass of cold water.
  - questionText: Are you hungry?
    discomfortLabel: Hungry
    suggestion: Have a snack or plan your next meal.
  - questionText: Are you thirsty?
    discomfortLabel: Thirsty
    suggestion: Drink some water.
  - questionText: Are you tired?
    discomfortLabel: Tired
    suggestion: Rest if you can, even for a few minutes.
  - questionText: Do you need to use the restroom?
    discomfortLabel: Restroom
    suggestion: Take a break to go.
  - questionText: Are you in any physical pain?
    discomfortLabel: In pain
    suggestion: See what you can do to aleve the pain and see a doctor if needed.
  - questionText: Are you feeling overwhelmed?
    discomfortLabel: Overwhelmed
    suggestion: Try a grounding or breathing exercise.
  - questionText: Are you feeling lonely?
    discomfortLabel: Lonely
    suggestion: Try reaching out to someone you trust and say hi.
  questionPanel: {fileID: 532835325}
  resultsPanel: {fileID: 1919252157}
  questionText: {fileID: 1451255775}
  progressText: {fileID: 252262433}
  resultsText: {fileID: 2072200246}
  noFlagsMessage: It seems like you're doing well. Enjoy your day.
  onComplete:
    m_PersistentCalls:
      m_Calls: []
