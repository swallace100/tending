  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GroundingExercise
  orientationQuestions:
  - What year is it?
  - What season is it?
  - What month is it?
  - What country are you in?
  - What town or city are you in?
  - What room are you in?
  sensePhases:
  - senseLabel: Touch
    itemCount: 5
    instruction: 'Touch 5 items near you and say their names out loud if you can.

      A
      part of your body is fine.'
    buttonLabel: I touched it
    summaryLead: 'You touched:'
  - senseLabel: Sight
    itemCount: 4
    instruction: 'Look around and name 4 things you can see.

      Anything counts,
      big or small.'
    buttonLabel: I see it
    summaryLead: 'You saw:'
  - senseLabel: Hearing
    itemCount: 3
    instruction: 'Listen for a moment and name 3 sounds you can hear.

      Quiet
      sounds count too.'
    buttonLabel: I hear it
    summaryLead: 'You heard:'
  - senseLabel: Smell
    itemCount: 2
    instruction: 'Name 2 things you can smell right now.

      If nothing comes
      to you, 2 smells you love work just as well.'
    buttonLabel: I smell it
    summaryLead: 'You smelled:'
  - senseLabel: Taste
    itemCount: 1
    instruction: 'Name 1 thing you can taste.

      A favorite taste from memory
      is fine too.'
    buttonLabel: I taste it
    summaryLead: 'You tasted:'
