  m_Script: {fileID: 11500000, guid: ac18d89dd5388c346921e66669d85bea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameSelectionMenu
  games:
  - displayName: Body Relaxation
    description: Relax each part of your body, one by one. Tense and release each
      muscle group, and just relax everything else.
    gameplayObject: {fileID: 1866207589}
  - displayName: Grounding
    description: A few questions to orient and ground yourself. It includes recalling
      where you are and touching objects around you. It works fine even if nothing
      is nearby.
    gameplayObject: {fileID: 1625395743}
  - displayName: Paced Breathing
    description: A steady breathe-in, breathe-out exercise that continues for as
      long as you'd like.
    gameplayObject: {fileID: 391310258}
  - displayName: Self Check-In
    description: A few yes-or-no questions about how your body is doing right now,
      along with advice on how to solve any issues that are found.
    gameplayObject: {fileID: 77683516}
  - displayName: Self Friend
    description: 'Think of a problem you''re carrying. Imagine a friend brought you
      the same one. What would you tell them? '
    gameplayObject: {fileID: 205483880}
  gameButtonsPanel: {fileID: 572515911}
  descriptionPanel: {fileID: 394102590}
  gamePanel: {fileID: 1664374466}
  titleText: {fileID: 1776914765}
  descriptionText: {fileID: 1983428100}
  startButton: {fileID: 255913145}
