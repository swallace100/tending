  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrisisHelpMenu
  helpPanel: {fileID: 930315358}
  helpText: {fileID: 1047258407}
  helpMessage: 'If you are in crisis or need support right now, you are not alone.


    United
    States: call or text 988 to reach the Suicide & Crisis Lifeline, any time, day
    or night.


    Outside the US: visit findahelpline.com, or search for "crisis
    line" and your country''s name to find a local number.


    If you are in immediate
    danger, call your local emergency number (911 in the US).


    This app is a
    self-care companion. It is not a substitute for professional mental health care.'
