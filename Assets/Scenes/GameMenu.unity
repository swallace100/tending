--- !u!114 &1866207591
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1866207589}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0c5e7732ed6fb204b977c3198eccb5a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyRelaxation
  steps:
  - bodyPartName: Forehead & Eyes
    canTense: 1
    tenseInstruction: Scrunch up your forehead and eyes tightly.
    relaxInstruction: Let your forehead and eyes go soft and loose.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Jaw & Mouth
    canTense: 1
    tenseInstruction: Clench your jaw and press your lips together.
    relaxInstruction: Let your jaw hang loose and your lips part slightly.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Neck & Throat
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your neck soften and your head feel heavy and supported.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Shoulders
    canTense: 1
    tenseInstruction: Shrug your shoulders up toward your ears.
    relaxInstruction: Let your shoulders drop and sink down.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Upper Arms
    canTense: 1
    tenseInstruction: Bend your elbows and squeeze your upper arms tight.
    relaxInstruction: Let your arms fall loose at your sides.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Elbows
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your elbows soften and unlock, with no effort holding them
      in place.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Forearms & Hands
    canTense: 1
    tenseInstruction: Clench your fists and tighten your forearms.
    relaxInstruction: Let your fingers uncurl and your hands go soft.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Wrists
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your wrists go loose and heavy.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Chest
    canTense: 1
    tenseInstruction: Take a deep breath in and hold it, tightening your chest.
    relaxInstruction: Breathe out slowly and let your chest settle.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Upper Back
    canTense: 1
    tenseInstruction: Squeeze your shoulder blades together.
    relaxInstruction: Let your back settle and widen.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Stomach
    canTense: 1
    tenseInstruction: Tighten your stomach muscles.
    relaxInstruction: Let your stomach soften with each breath.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Lower Back
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your lower back settle into a comfortable, supported position.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Hips
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your hips feel heavy and supported, with nothing to hold
      up.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Glutes
    canTense: 1
    tenseInstruction: Squeeze your glutes tight.
    relaxInstruction: Let them soften completely.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Thighs
    canTense: 1
    tenseInstruction: Tighten the muscles in your thighs.
    relaxInstruction: Let your thighs go heavy and loose.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Knees
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your knees soften and unlock.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Calves
    canTense: 1
    tenseInstruction: Point your toes and tighten your calves.
    relaxInstruction: Let your calves relax completely.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Ankles
    canTense: 0
    tenseInstruction: 
    relaxInstruction: Let your ankles go loose and heavy.
    tenseDuration: 5
    relaxDuration: 10
  - bodyPartName: Feet & Toes
    canTense: 1
    tenseInstruction: Curl your toes tightly.
    relaxInstruction: Let your toes and feet go fully loose.
    tenseDuration: 5
    relaxDuration: 10
  stepPanel: {fileID: 1590031838}
  completePanel: {fileID: 123128122}
  bodyPartText: {fileID: 1906171041}
  instructionText: {fileID: 572482443}
  progressText: {fileID: 180134935}
  timerText: {fileID: 1956903890}
  timerFillImage: {fileID: 1138231727}
  completeText: {fileID: 0}
  completeMessage: You've relaxed your whole body. Notice how you feel now.
